# Copia este archivo como ".env" y rellena los valores. NUNCA subas .env a GitHub.

# "production" en el servidor público (activa cookies seguras, HSTS y comprobaciones estrictas)
NODE_ENV=development
PORT=4000

# Secreto para firmar las sesiones. Obligatorio en producción (mínimo 32 caracteres). Genera uno con:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# Carpeta donde se guarda la base de datos (en producción, un disco persistente)
DATA_DIR=./data

# Consultor IA: tu clave de la API de Anthropic (console.anthropic.com). Si la dejas vacía, el consultor se desactiva.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5
# Tope global de consultas a la IA por día (protege tu factura aunque alguien cree muchas cuentas)
AI_DAILY_LIMIT=500

# Feeds RSS para los titulares en directo (separados por comas). Puedes añadir los de medios de tu país.
NEWS_FEEDS=https://feeds.bbci.co.uk/news/business/rss.xml,https://www.cnbc.com/id/100003114/device/rss/rss.html

# Número de proxies delante del servidor (Render, Railway, nginx: 1). No uses "true": permitiría falsear la IP.
TRUST_PROXY=1

# Solo si sirves la web desde OTRO dominio distinto al del servidor (normalmente déjalo vacío)
ALLOWED_ORIGINS=

# Los administradores del foro ya NO se definen aquí por correo: se nombran con
#   npm run make-admin -- tu@correo.com
# (ver README, apartado de seguridad)

# ---------- Premium (4,99 €/mes con Stripe) ----------
# Sin estas tres claves la web funciona igual, pero el botón de suscribirse aparece desactivado.
# Usa primero las claves de PRUEBA (sk_test_...) y cambia a las reales (sk_live_...) al publicar.
STRIPE_SECRET_KEY=
# ID del precio mensual de 4,99 € (Stripe → Catálogo de productos → tu producto → Precio: price_...)
STRIPE_PRICE_ID=
# Secreto del webhook (Stripe → Desarrolladores → Webhooks → tu endpoint: whsec_...)
STRIPE_WEBHOOK_SECRET=
# "true" si activas Stripe Tax para que calcule el IVA según el país del cliente
STRIPE_AUTOMATIC_TAX=false
# Dirección pública https de la web (obligatoria en producción con pagos). Stripe vuelve aquí tras pagar.
PUBLIC_URL=
